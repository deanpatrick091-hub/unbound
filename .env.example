# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# Google Gemini API key (server-side only — never prefixed with NEXT_PUBLIC_).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Gemini model to use. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# Supabase project URL and *publishable* key (Dashboard → Project Settings → API Keys).
# Both are public by design and safe to expose to the browser.
# NEVER put the service-role (secret) key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
