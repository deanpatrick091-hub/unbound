# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# Google Gemini API key (server-side only — never prefixed with NEXT_PUBLIC_).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default model as provider:model. Defaults to gemini:gemini-3.6-flash.
# GEMINI_MODEL=gemini:gemini-3.6-flash

# --- Additional AI providers (all optional; a provider is hidden until its key is set) ---
# Groq — free tier at https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras — free tier at https://cloud.cerebras.ai (OpenAI-compatible; models discovered live)
CEREBRAS_API_KEY=
# OpenRouter — free ":free" models at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=UNBOUND
# Ollama — local models. Set the base URL to enable; models are discovered from /api/tags.
# OLLAMA_BASE_URL=http://localhost:11434

# Supabase project URL and *publishable* key (Dashboard → Project Settings → API Keys).
# Both are public by design and safe to expose to the browser.
# NEVER put the service-role (secret) key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
