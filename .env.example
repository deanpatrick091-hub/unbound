# Copy to .env.local for local development. Put production values in Vercel.
# NEVER put private provider keys in NEXT_PUBLIC_ variables or commit .env.local.
SITE_URL=https://unbound-lilac.vercel.app

# Required Supabase public configuration. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter: only zero-priced text routes, with a per-request $0 price ceiling.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://unbound-lilac.vercel.app
OPENROUTER_APP_NAME=Unbound AI

# Google: Gemma 4 is free-only and works with the key alone.
# Flash models stay hidden until the project is verified on Gemini Free tier.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false

# Existing Groq Free plan only; do not enable on a paid/Developer organization.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false

# Workers FREE plan only. Paid accounts can incur overage fees.
# Token needs Workers AI access for this account. Enables chat and FLUX images.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_TIER_CONFIRMED=false

# Mistral Free mode, with pay-as-you-go OFF and no paid subscription.
MISTRAL_API_KEY=
MISTRAL_FREE_TIER_CONFIRMED=false

# Free personal HF account: $0.10 monthly, no purchased credits, paid plan,
# automatic top-ups, custom provider keys or organization billing.
HF_TOKEN=
HUGGINGFACE_FREE_TIER_CONFIRMED=false

# Zero-priced Flash models only. Confirm free pricing/no paid credit balance.
# No search tools, FlashX, paid models or Coding Plan endpoints are used.
ZAI_API_KEY=
ZAI_FREE_TIER_CONFIRMED=false

# Optional local Ollama. Vercel cannot reach Ollama on your PC via localhost.
# Run Unbound locally alongside Ollama, or supply an already secured server URL.
# OLLAMA_BASE_URL=http://localhost:11434
